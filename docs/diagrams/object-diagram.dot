digraph ObjectDiagram {
 graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="0.7", fontname="DejaVu Sans", labelloc="t", label="UML OBJECT DIAGRAM — SAMPLE RUNTIME SNAPSHOT", fontsize=19, fontcolor="#16324F"];
 node [shape=plain, fontname="DejaVu Sans", fontsize=10, fontcolor="#16324F"];
 edge [fontname="DejaVu Sans", fontsize=9, color="#147D86", fontcolor="#305A68", penwidth=1.2, arrowsize=0.7];
 d1 [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#31556B"><TR><TD BGCOLOR="#D6E8F7"><B><U>doctor01 : Doctor</U></B></TD></TR><TR><TD ALIGN="LEFT">id = "doc-001"</TD></TR><TR><TD ALIGN="LEFT">name = "Dr. Demo Rahman"</TD></TR><TR><TD ALIGN="LEFT">hospital = "Demo Clinic"</TD></TR><TR><TD ALIGN="LEFT">department = "Medicine"</TD></TR></TABLE> >];
 p1 [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#31556B"><TR><TD BGCOLOR="#E5F3E7"><B><U>patient01 : Patient</U></B></TD></TR><TR><TD ALIGN="LEFT">name = "Sample Patient"</TD></TR><TR><TD ALIGN="LEFT">phone = "01700000000"</TD></TR><TR><TD ALIGN="LEFT">registrationNo = "R10003"</TD></TR></TABLE> >];
 a1 [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#31556B"><TR><TD BGCOLOR="#FFF1D7"><B><U>appointment01 : Appointment</U></B></TD></TR><TR><TD ALIGN="LEFT">id = "TG-1001"</TD></TR><TR><TD ALIGN="LEFT">date = "2026-11-12"</TD></TR><TR><TD ALIGN="LEFT">serial = 1</TD></TR><TR><TD ALIGN="LEFT">status = "pending"</TD></TR></TABLE> >];
 a1 -> d1 [label="doctor"];
 a1 -> p1 [label="patient"];
 note [shape=note, style=filled, fillcolor="#FFF9EA", color="#C79B42", label="Illustrative objects only. Names, phone and IDs are\nsynthetic examples, not real patient records or a booking."];
 note -> p1 [style=dashed, arrowhead=none, color="#C79B42"];
}
